# Passmark AI Test Automation Environment Variables

# AI Provider API Keys
# Passmark uses Gemini by default for step execution and Claude/Gemini for multi-model consensus
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Redis Cache URL
# Used by Passmark to cache successful steps. If not running, Passmark falls back to cold AI runs.
# Local Docker Redis:
REDIS_URL=redis://localhost:6379

# Optional: Cloud Redis (e.g. Upstash) when Docker is unavailable:
# REDIS_URL=rediss://default:yourpassword@your-endpoint.upstash.io:6379
