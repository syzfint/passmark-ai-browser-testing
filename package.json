{
  "name": "passmark-ai-testing-hacathon",
  "version": "1.0.0",
  "description": "AI Browser Regression Testing with Passmark, Playwright, and Redis Caching",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "tsc --noEmit"
  },
  "keywords": [
    "passmark",
    "playwright",
    "ai-testing",
    "regression-testing",
    "redis-cache",
    "bug0"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "passmark": "^1.0.16",
    "typescript": "^5.9.3"
  }
}
